# Copier en local avec : cp .env.example .env
# Remplacer uniquement les variables des services que vous activez. Ne committer jamais .env.

# WhatsApp / propriétaire
OWNER_NUMBER=
PHONE_NUMBER=

# Site multi-session (sur Sevalla, conserver ces valeurs dans les variables privées)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
MULTISESSION_DATA_DIR=
MAX_SESSIONS=5
SESSION_NODE_HEAP_MB=170

# Fournisseurs de texte, vision, audio et traduction
XKIRO_API_KEY=
NVIDIA_API_KEY=
TOKENHARBOR_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
FREE_AI_API_KEY=
ASSEMBLYAI_API_KEY=
TRANSLATE_API_KEY=

# APIs et médias facultatifs
KCEY_API_KEY=
KNIGHTBOT_API_KEY=
GIPHY_API_KEY=
NEWS_API_KEY=
NASA_API_KEY=
OPENWEATHER_API_KEY=
TMDB_API_KEY=
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
TELEGRAM_BOT_TOKEN=

# Options XKIRO facultatives
XKIRO_BASE_URL=
XKIRO_MODEL_TEXT=
XKIRO_MODEL_VISION=
XKIRO_MODEL_AUDIO=

# Jeton obligatoire pour api/chat.js et npm run start:chat-api
CHAT_API_TOKEN=

# Sevalla test runtime
MULTISESSION_DATA_DIR=/tmp/multisession-data

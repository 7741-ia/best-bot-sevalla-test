{
  "name": "best-king-bot",
  "version": "3.3",
  "description": "WhatsApp Bot",
  "main": "index.js",
  "scripts": {
    "start": "node --expose-gc --max-old-space-size=768 index.js",
    "start:single": "node --expose-gc --max-old-space-size=768 session-worker.js",
    "start:chat-api": "node server/chat-api.js",
    "start:optimized": "node --expose-gc --max-old-space-size=768 index.js",
    "cleanup": "node cleanup.js",
    "reset-session": "node reset-session.js",
    "start:clean": "npm run cleanup && npm run start:optimized",
    "start:fresh": "npm run reset-session -- --confirm && npm run start:single",
    "install:panel": "npm install --legacy-peer-deps",
    "install:force": "npm install --force",
    "test": "node tests/kcey.test.js && node --test tests/movies.test.js tests/chatApi.test.js tests/statusMediaCleanup.test.js tests/statusArchiveMigration.test.js tests/groupSettings.test.js tests/waMessage.test.js tests/assistantMemory.test.js tests/stickerLibrary.test.js tests/whatsappAuthStorage.test.js tests/multisession.test.js",
    "test:chat-api": "node --test tests/chatApi.test.js",
    "test:movies": "node --test tests/movies.test.js",
    "test:status-media": "node --test tests/statusMediaCleanup.test.js",
    "test:status-migration": "node --test tests/statusArchiveMigration.test.js",
    "test:group-settings": "node --test tests/groupSettings.test.js",
    "test:kcey": "node tests/kcey.test.js",
    "test:tokenharbor": "node tests/tokenharbor.test.js",
    "test:nvidia": "node tests/nvidia.test.js",
    "test:kcey:live": "node tests/kcey.test.js --live",
    "docker:build": "docker build -t best-king-bot .",
    "test:gemini": "node tests/gemini.test.js"
  },
  "keywords": [
    "whatsapp-bot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "6.7.24",
    "awesome-phonenumber": "^5.9.0",
    "axios": "^1.8.4",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.4.5",
    "file-type": "^16.5.4",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.1",
    "fs-extra": "^11.2.0",
    "gtts": "^0.2.1",
    "human-readable": "^0.2.1",
    "jimp": "^1.6.0",
    "libphonenumber-js": "^1.11.18",
    "libsignal": "^2.0.1",
    "link-preview-js": "^3.0.5",
    "moment-timezone": "^0.5.43",
    "mumaker": "^2.0.0",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0",
    "node-id3": "^0.2.3",
    "node-webpmux": "^3.1.0",
    "node-youtube-music": "^0.8.3",
    "pino": "^8.21.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ruhend-scraper": "^8.3.0",
    "sharp": "^0.32.6",
    "ws": "^8.17.1",
    "youtube-yts": "^2.0.0",
    "yt-search": "^2.12.1",
    "ytdl-core": "^4.11.5"
  },
  "overrides": {
    "jimp": "^1.6.0"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
